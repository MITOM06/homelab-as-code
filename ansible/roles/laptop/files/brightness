#!/bin/bash
# brightness [0-100] — xem / đặt độ sáng màn hình HP (cần sudo khi đặt)
d=/sys/class/backlight/intel_backlight
max=$(<"$d/max_brightness")
if [ -z "$1" ]; then echo "Độ sáng: $(( ($(<"$d/brightness") * 100 + max / 2) / max ))%"; exit 0; fi
[[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -le 100 ] || { echo "Dùng: brightness 0-100"; exit 1; }
v=$(( $1 * max / 100 )); [ "$v" -lt 1 ] && [ "$1" -gt 0 ] && v=1
if [ -w "$d/brightness" ]; then echo "$v" > "$d/brightness"; else echo "$v" | sudo tee "$d/brightness" >/dev/null; fi
echo "Độ sáng: $1%"
